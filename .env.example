# Copy to .env. Configure credentials only on the backend.
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_KNOWLEDGE_IDS=
QWEN_MODEL=qwen-plus
# Optional compatible-mode endpoint:
# QWEN_BASE_URL=
BACKEND_PORT=5000
